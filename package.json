{
  "name": "re-list",
  "version": "1.0.1",
  "description": "Re:List Anime Tracker",
  "author": "Re-List",
  "main": "main.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.relist.app",
    "productName": "Re:List",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "logo.png",
      "terms.txt",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "frontend/dist/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "terms.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Re:List",
      "uninstallDisplayName": "Re:List"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Re-List",
        "repo": "AnimeViewerV3"
      }
    ]
  }
}